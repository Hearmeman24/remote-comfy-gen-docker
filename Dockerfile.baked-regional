# syntax=docker/dockerfile:1.7
# One-shot alternative. For constrained 150-GB builders use the incremental layer helper.
ARG BASE_IMAGE=hearmeman/comfyui-serverless:v38@sha256:897b7f4ab6c24536e3e25d426f9b72363677e81981a3d4817f8443dbed5cde95
FROM --platform=linux/amd64 python:3.12-slim@sha256:e8a38829209aea82774882e5157e1f7c3e8c8393ff53a697b3580896e57f345c AS model-download
COPY download_baked_model.py /download_baked_model.py
COPY baked-models.manifest.json /baked-models.manifest.json
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --no-cache-dir "huggingface_hub==2.2.0" "click==8.5.0" \
    && hf version \
    && hf download --help >/dev/null \
    && hf download --help | grep -q -- '--quiet' \
    && python3 /download_baked_model.py --validate-manifest-only
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id krea2_turbo_bf16.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id qwen3vl_4b_fp8_scaled.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id qwen3vl_4b_bf16.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id Wan2_1_VAE_fp32.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id seedvr2_ema_7b_fp16.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id ema_vae_fp16.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id umt5_xxl_fp8_e4m3fn_scaled.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id wan_2.1_vae.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id clip_vision_h.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id sam3.1_multiplex_fp16.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id wan2.1_SCAIL_2_DPO_lora_bf16.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id wan2.1_14B_SCAIL_2_int8_convrot.safetensors --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id rife426.pth --target-root /baked-models
RUN --mount=type=secret,id=hf_token,required=true python3 /download_baked_model.py --asset-id taew2_1.pth --target-root /baked-models
FROM --platform=linux/amd64 ${BASE_IMAGE} AS final
ARG BASE_IMAGE
LABEL org.hearmemanai.comfygen.image-variant="baked-regional" \
      org.hearmemanai.comfygen.base-image="${BASE_IMAGE}" \
      org.hearmemanai.comfygen.runtime-commit="60fdc14d6b3a4bccf181f8aa8e6983d0311766da" \
      org.opencontainers.image.title="Krea 2 and SCAIL 2 ComfyGen runtime" \
      org.opencontainers.image.description="ComfyGen runtime image with model-specific license notices; Krea 2 assets require recipient agreement to the Krea 2 Community License."
ENV AUX_ANNOTATOR_CKPTS_PATH=/runpod-volume/ComfyUI/models/annotator_ckpts
COPY --link extra_model_paths.baked-regional.yaml /ComfyUI/extra_model_paths.yaml
COPY --link --chmod=0755 start_script.baked-regional.sh /start_script.sh
COPY --link log_forwarder.py /log_forwarder.py
COPY --link MODEL-NOTICES.md /usr/share/comfygen-model-licenses/MODEL-NOTICES.md
COPY --link notices/ /usr/share/comfygen-model-licenses/
COPY --link --from=model-download /baked-models/diffusion_models/krea2_turbo_bf16.safetensors /ComfyUI/models/diffusion_models/krea2_turbo_bf16.safetensors
COPY --link --from=model-download /baked-models/text_encoders/qwen3vl_4b_fp8_scaled.safetensors /ComfyUI/models/text_encoders/qwen3vl_4b_fp8_scaled.safetensors
COPY --link --from=model-download /baked-models/text_encoders/qwen3vl_4b_bf16.safetensors /ComfyUI/models/text_encoders/qwen3vl_4b_bf16.safetensors
COPY --link --from=model-download /baked-models/vae/Wan2_1_VAE_fp32.safetensors /ComfyUI/models/vae/Wan2_1_VAE_fp32.safetensors
COPY --link --from=model-download /baked-models/SEEDVR2/seedvr2_ema_7b_fp16.safetensors /ComfyUI/models/SEEDVR2/seedvr2_ema_7b_fp16.safetensors
COPY --link --from=model-download /baked-models/SEEDVR2/ema_vae_fp16.safetensors /ComfyUI/models/SEEDVR2/ema_vae_fp16.safetensors
COPY --link --from=model-download /baked-models/clip/umt5_xxl_fp8_e4m3fn_scaled.safetensors /ComfyUI/models/clip/umt5_xxl_fp8_e4m3fn_scaled.safetensors
COPY --link --from=model-download /baked-models/vae/wan_2.1_vae.safetensors /ComfyUI/models/vae/wan_2.1_vae.safetensors
COPY --link --from=model-download /baked-models/clip_vision/clip_vision_h.safetensors /ComfyUI/models/clip_vision/clip_vision_h.safetensors
COPY --link --from=model-download /baked-models/checkpoints/sam3.1_multiplex_fp16.safetensors /ComfyUI/models/checkpoints/sam3.1_multiplex_fp16.safetensors
COPY --link --from=model-download /baked-models/loras/lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors /ComfyUI/models/loras/lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors
COPY --link --from=model-download /baked-models/loras/wan2.1_SCAIL_2_DPO_lora_bf16.safetensors /ComfyUI/models/loras/wan2.1_SCAIL_2_DPO_lora_bf16.safetensors
COPY --link --from=model-download /baked-models/diffusion_models/wan2.1_14B_SCAIL_2_int8_convrot.safetensors /ComfyUI/models/diffusion_models/wan2.1_14B_SCAIL_2_int8_convrot.safetensors
COPY --link --from=model-download /baked-models/frame_interpolation/rife426.pth /ComfyUI/models/frame_interpolation/rife426.pth
COPY --link --from=model-download /baked-models/vae_approx/taew2_1.pth /ComfyUI/models/vae_approx/taew2_1.pth
CMD ["/start_script.sh"]
